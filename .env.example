CONVEX_DEPLOYMENT=CONVEX_DEPLOYMENT_NAME
NEXT_PUBLIC_CONVEX_URL=PUBLIC_CONVEX_URL_DEV

# Convex Auth (required for @convex-dev/auth)
# Generate keys by running: node generateKeys.mjs (see @convex-dev/auth docs)
# Set these in your Convex dashboard environment variables
JWT_PRIVATE_KEY=YOUR_JWT_PRIVATE_KEY
JWKS=YOUR_JWKS_JSON

# Google Gemini Configuration (for menu extraction)
# Get your API key from: https://aistudio.google.com/app/apikey
NEXT_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

NEXT_OPENAI_KEY=OPENAI_API_KEY
NEXT_PUBLIC_VIRTUAL_NUMBER=TWILIO_PHONE_NUMBER

# This is used in the API route and contains the exact same number as public virtual number but without any special characters like `-`
NEXT_VIRTUAL_NUMBER=TWILIO_PHONE_NUMBER_WITHOUT_ANY_SPECIAL_CHARS 

NEXT_TWILIO_SID=TWILIO_SID
NEXT_TWILIO_AUTH_TOKEN=TWILIO_AUTH_TOKEN

# `ws-server` dir env
NEXT_BACKEND_PORT=PORT_FOR_THE_WS_SERVER

# Internal API shared secret (server-to-server).
# Gates the Next `(internal-use)` API routes via the `x-api-key` header AND is
# forwarded to the "internal" Convex functions (upsertCallData, addTranscript,
# upsertOrders, getRestaurantAndMenuDetailsUsingId) so a direct Convex call
# cannot bypass the Next-layer check. For that defense-in-depth to hold, the
# SAME value must be set BOTH here (Next env) AND on the Convex deployment
# (`npx convex env set INTERNAL_API_KEY <value>`). When unset, both layers allow
# calls (local dev only). Treat as a SECRET; never commit a real value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=YOUR_64_HEX_CHAR_INTERNAL_API_KEY

# Integration credential encryption key (AES-256-GCM).
# Encrypts/decrypts stored Runsheet API keys and webhook secrets. The ws-server
# needs this to decrypt a tenant's Runsheet credentials in-process when a voice
# call routes to the Runsheet pack. Treat as a SECRET; never commit a real value.
# Must be 32 bytes: 64 hex characters (recommended) or a 32-byte UTF-8 string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=YOUR_64_HEX_CHAR_ENCRYPTION_KEY

# Runsheet runtime service token (shared secret).
# Authorizes the standalone ws-server to fetch a tenant's Runsheet integration
# config (ciphertext + settings) from Convex via the guarded
# `runsheet.integrationsData.getIntegrationForRuntime` ACTION. The SAME value
# must be set BOTH on the ws-server's environment AND on the Convex deployment
# (`npx convex env set RUNSHEET_RUNTIME_SERVICE_TOKEN <value>`). Fail-closed: if
# unset or mismatched, Runsheet config retrieval is rejected and Runsheet voice
# calls start without Runsheet tools. Treat as a SECRET; never commit a real value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RUNSHEET_RUNTIME_SERVICE_TOKEN=YOUR_64_HEX_CHAR_SERVICE_TOKEN

# Paystack Payment Integration (Nigerian market)
# Get your API keys from: https://dashboard.paystack.com/#/settings/developers
# Use sk_test_* keys for development/staging, sk_live_* for production
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET_KEY
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PAYSTACK_PUBLIC_KEY
# Optional: Callback URL for payment completion redirects
PAYSTACK_CALLBACK_URL=https://your-domain.com/payment/callback

# Stripe Payment Integration (United States market)
# Get your API keys from: https://dashboard.stripe.com/apikeys
# Use sk_test_* keys for development/staging, sk_live_* for production
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
# Webhook signing secret from https://dashboard.stripe.com/webhooks
# Point the Stripe webhook at: /client/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# Flutterwave Payment Integration (Nigerian market)
# Get your API keys from: https://dashboard.flutterwave.com/settings/apis
# Use FLWSECK_TEST* keys for development/staging, FLWSECK* for production
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-YOUR_FLUTTERWAVE_SECRET_KEY
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-YOUR_FLUTTERWAVE_PUBLIC_KEY
# Optional: Redirect URL for payment completion
FLUTTERWAVE_REDIRECT_URL=https://your-domain.com/payment/callback
# Optional: Webhook secret for verifying webhook signatures
FLUTTERWAVE_WEBHOOK_SECRET=YOUR_FLUTTERWAVE_WEBHOOK_SECRET
# Optional: Logo URL to display on payment page
FLUTTERWAVE_LOGO_URL=https://your-domain.com/logo.png

# Rider API Authentication (for delivery status updates)
# API key for authenticating rider API requests
# Format: rider_{riderId}_{secret} or a simple secret key
# In production, use a secure random string
RIDER_API_KEY=YOUR_RIDER_API_SECRET_KEY

# WhatsApp Business API Integration
# Get your credentials from: https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=YOUR_WHATSAPP_VERIFY_TOKEN
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID

# Upstash Redis (for distributed rate limiting)
# Get your credentials from: https://console.upstash.com/
# Required for production; if unset, falls back to in-memory rate limiter (dev only)
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN

# Africa's Talking (voice number provisioning for GH, KE, ZA)
# Get your credentials from: https://account.africastalking.com/
# Use 'sandbox' as username for development
AT_API_KEY=YOUR_AFRICAS_TALKING_API_KEY
AT_USERNAME=YOUR_AFRICAS_TALKING_USERNAME

# Termii (dedicated number provisioning for Nigeria)
# Get your API key from: https://accounts.termii.com/
TERMII_API_KEY=YOUR_TERMII_API_KEY