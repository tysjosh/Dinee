CONVEX_DEPLOYMENT=CONVEX_DEPLOYMENT_NAME
NEXT_PUBLIC_CONVEX_URL=PUBLIC_CONVEX_URL_DEV

# Google Gemini Configuration (for menu extraction)
# Get your API key from: https://aistudio.google.com/app/apikey
NEXT_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

NEXT_OPENAI_KEY=OPENAI_API_KEY
NEXT_PUBLIC_VIRTUAL_NUMBER=TWILIO_PHONE_NUMBER

# This is used in the API route and contains the exact same number as public virtual number but without any special characters like `-`
NEXT_VIRTUAL_NUMBER=TWILIO_PHONE_NUMBER_WITHOUT_ANY_SPECIAL_CHARS 

NEXT_TWILIO_SID=TWILIO_SID
NEXT_TWILIO_AUTH_TOKEN=TWILIO_AUTH_TOKEN

# `ws-server` dir env
NEXT_BACKEND_PORT=PORT_FOR_THE_WS_SERVER

# Paystack Payment Integration (Nigerian market)
# Get your API keys from: https://dashboard.paystack.com/#/settings/developers
# Use sk_test_* keys for development/staging, sk_live_* for production
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_SECRET_KEY
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PAYSTACK_PUBLIC_KEY
# Optional: Callback URL for payment completion redirects
PAYSTACK_CALLBACK_URL=https://your-domain.com/payment/callback

# Flutterwave Payment Integration (Nigerian market)
# Get your API keys from: https://dashboard.flutterwave.com/settings/apis
# Use FLWSECK_TEST* keys for development/staging, FLWSECK* for production
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-YOUR_FLUTTERWAVE_SECRET_KEY
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-YOUR_FLUTTERWAVE_PUBLIC_KEY
# Optional: Redirect URL for payment completion
FLUTTERWAVE_REDIRECT_URL=https://your-domain.com/payment/callback
# Optional: Webhook secret for verifying webhook signatures
FLUTTERWAVE_WEBHOOK_SECRET=YOUR_FLUTTERWAVE_WEBHOOK_SECRET
# Optional: Logo URL to display on payment page
FLUTTERWAVE_LOGO_URL=https://your-domain.com/logo.png

# Rider API Authentication (for delivery status updates)
# API key for authenticating rider API requests
# Format: rider_{riderId}_{secret} or a simple secret key
# In production, use a secure random string
RIDER_API_KEY=YOUR_RIDER_API_SECRET_KEY

# WhatsApp Business API Integration
# Get your credentials from: https://developers.facebook.com/apps/
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=YOUR_WHATSAPP_VERIFY_TOKEN
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID